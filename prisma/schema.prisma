generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REJECTED
  REFUNDED
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  roles        UserRole[]
  profile      CustomerProfile?
  sessions     Session[]
  accounts     TradingAccount[]
  payments     Payment[]
  ledger       LedgerEntry[]
  documents    KycDocument[]
}

model Role {
  id    String     @id @default(uuid())
  name  String     @unique
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model MfaFactor {
  id      String @id @default(uuid())
  userId  String
  secret  String
  enabled Boolean @default(false)
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  success   Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model CustomerProfile {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id])
  firstName String
  lastName  String
  country   String?
  phone     String?
}

model AccountType {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String
  swapFree       Boolean  @default(false)
  minimumDeposit Decimal? @db.Decimal(18, 2)
  leverage       String?
  status         String   @default("active")
  sortOrder      Int      @default(0)
  accounts       TradingAccount[]
}

model TradingAccount {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  accountTypeId String
  accountType   AccountType @relation(fields: [accountTypeId], references: [id])
  currency      String
  login         String      @unique
  simulated     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  ledger        LedgerEntry[]

  @@index([userId])
}

model Instrument {
  id         String  @id @default(uuid())
  symbol     String  @unique
  category   String
  status     String  @default("active")
  leverage   String?
  minVolume  Decimal? @db.Decimal(18, 8)
  orders     Order[]
  positions  Position[]
}

model Order {
  id           String     @id @default(uuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  side         String
  type         String
  volume       Decimal    @db.Decimal(18, 8)
  price        Decimal?   @db.Decimal(18, 8)
  status       String
  createdAt    DateTime   @default(now())

  @@index([status])
}

model Position {
  id           String     @id @default(uuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  side         String
  volume       Decimal    @db.Decimal(18, 8)
  openPrice    Decimal    @db.Decimal(18, 8)
  openedAt     DateTime   @default(now())
}

model Trade {
  id        String   @id @default(uuid())
  accountId String
  symbol    String
  volume    Decimal  @db.Decimal(18, 8)
  price     Decimal  @db.Decimal(18, 8)
  createdAt DateTime @default(now())

  @@index([accountId])
}

model Payment {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  amount         Decimal       @db.Decimal(18, 8)
  currency       String
  status         PaymentStatus @default(PENDING)
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, status])
}

model LedgerEntry {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  accountId      String
  account        TradingAccount @relation(fields: [accountId], references: [id])
  amount         Decimal        @db.Decimal(18, 8)
  currency       String
  reason         String
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())

  @@index([accountId])
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  type        String
  amount      Decimal  @db.Decimal(18, 8)
  currency    String
  status      String
  reference   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
}

model QuestionnaireVersion {
  id        String   @id @default(uuid())
  schema    Json
  createdAt DateTime @default(now())
}

model QuestionnaireResponse {
  id        String   @id @default(uuid())
  userId    String
  versionId String
  answers   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

model KycDocument {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  category  String
  storageKey String
  status    KycStatus @default(PENDING)
  reason    String?
  createdAt DateTime  @default(now())

  @@index([userId, status])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
